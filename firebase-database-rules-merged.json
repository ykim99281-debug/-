{
  "rules": {
    "brainRpg": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('brainRpgAdmins/' + auth.uid).exists())",
        ".write": "auth != null && ((auth.uid === $uid && !root.child('brainRpgBans/' + $uid).exists() && !root.child('brainRpgConfig/maint/on').exists()) || root.child('brainRpgAdmins/' + auth.uid).exists())",
        ".validate": "!root.child('brainRpgConfig/minVersion').exists() || newData.child('v').val() >= root.child('brainRpgConfig/minVersion').val()"
      }
    },
    "brainRpgPub": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !root.child('brainRpgBans/' + $uid).exists() && !root.child('brainRpgConfig/maint/on').exists()) || root.child('brainRpgAdmins/' + auth.uid).exists())"
      }
    },
    "brainRpgAdmins": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.token.email === 'geab980ebaa85eca480@brainrpg.local' && auth.uid === $uid && newData.val() === 'super') || (root.child('brainRpgAdmins/' + auth.uid).val() === 'super' && $uid !== auth.uid && (newData.val() === true || !newData.exists()) && data.val() !== 'super'))"
      }
    },
    "brainRpgBans": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists() && $uid !== auth.uid && root.child('brainRpgAdmins/' + $uid).val() !== 'super' && (root.child('brainRpgAdmins/' + auth.uid).val() === 'super' || !root.child('brainRpgAdmins/' + $uid).exists())"
      }
    },
    "brainRpgConfig": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()"
    },
    "brainRpgEvent": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()"
    },
    "brainRpgLive": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !root.child('brainRpgBans/' + $uid).exists() && !root.child('brainRpgConfig/maint/on').exists()) || root.child('brainRpgAdmins/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['name','x','z','t']) && (!root.child('brainRpgConfig/minVersion').exists() || newData.child('v').val() >= root.child('brainRpgConfig/minVersion').val())"
      }
    },
    "brainRpgPk": {
      "$target": {
        ".read": "auth != null && auth.uid === $target",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('f').val() === auth.uid) || (data.exists() && !newData.exists() && auth.uid === $target))"
        }
      }
    },
    "heroIdle": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('brainRpgAdmins/' + auth.uid).exists())",
        ".write": "auth != null && ((auth.uid === $uid && !root.child('heroIdleBans/' + $uid).exists() && !root.child('heroIdleConfig/maint/on').exists()) || root.child('brainRpgAdmins/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['name','t','save']) && newData.child('save').isString() && newData.child('save').val().length < 300000 && (!root.child('heroIdleConfig/minVersion').exists() || newData.child('v').val() >= root.child('heroIdleConfig/minVersion').val())"
      }
    },
    "heroIdlePub": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && !root.child('heroIdleBans/' + $uid).exists() && !root.child('heroIdleConfig/maint/on').exists()) || root.child('brainRpgAdmins/' + auth.uid).exists())"
      }
    },
    "heroIdleBans": {
      ".read": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists() && $uid !== auth.uid && root.child('brainRpgAdmins/' + $uid).val() !== 'super' && (root.child('brainRpgAdmins/' + auth.uid).val() === 'super' || !root.child('brainRpgAdmins/' + $uid).exists())"
      }
    },
    "heroIdleEvent": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()"
    },
    "heroIdleConfig": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('brainRpgAdmins/' + auth.uid).exists()"
    },
    "members": {
      ".read": "auth != null",
      "$n": {
        ".write": "root.child('admins/' + auth.uid).exists()"
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "auth != null && (!root.child('admins').exists() || root.child('admins/' + auth.uid).exists())"
    },
    "claims": {
      ".read": "auth != null",
      "$n": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('members/' + $n).exists()) || root.child('admins/' + auth.uid).exists())"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && root.child('claims/' + newData.val()).val() === auth.uid"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$room": {
        ".indexOn": [
          "t"
        ],
        "$id": {
          ".write": "auth != null && ((!data.exists() && (newData.child('n').val() === root.child('users/' + auth.uid).val() || (newData.child('n').val() === '운영자' && root.child('admins/' + auth.uid).exists()))) || (data.exists() && (data.child('n').val() === root.child('users/' + auth.uid).val() || root.child('admins/' + auth.uid).exists())))"
        }
      }
    },
    "checks": {
      ".read": "auth != null",
      "$d": {
        "$n": {
          ".write": "auth != null && root.child('claims/' + $n).val() === auth.uid"
        }
      }
    },
    "games": {
      ".read": "auth != null",
      "quiz": {
        "$n": {
          ".write": "auth != null && root.child('claims/' + $n).val() === auth.uid"
        }
      }
    }
  }
}