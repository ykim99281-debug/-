{
  "rules": {
    "anime": {
      "names": {
        ".read": "auth!=null",
        "$n": {
          ".write": "auth!=null && ((!data.exists() && newData.val()===auth.uid && !root.child('anime/uids/'+auth.uid).exists() && $n.matches(/^[가-힣A-Za-z0-9_]{2,12}$/) && $n!=='제작자' && $n!=='운영자' && $n!=='관리자' && $n.toLowerCase()!=='system' && $n.toLowerCase()!=='guest') || (data.exists() && data.val()===auth.uid && !newData.exists()))"
        }
      },
      "uids": {
        "$uid": {
          ".read": "auth!=null && (auth.uid===$uid || root.child('anime/admins/'+auth.uid).exists())",
          ".write": "auth!=null && auth.uid===$uid && ((!data.exists() && newData.isString() && root.child('anime/names/'+newData.val()).val()===auth.uid) || !newData.exists())"
        }
      },
      "admins": {
        "$uid": {
          ".read": "auth!=null && (auth.uid===$uid || (root.child('anime/admins/'+auth.uid).val())==='owner')",
          ".write": "auth!=null && (root.child('anime/admins/'+auth.uid).val())==='owner' && $uid!==auth.uid && (newData.val()==='mod' || !newData.exists())"
        }
      },
      "staff": {
        ".read": "auth!=null",
        "$n": {
          ".write": "auth!=null && root.child('anime/names/'+$n).exists() && (((root.child('anime/admins/'+auth.uid).val())==='owner' && data.val()!=='owner' && (newData.val()==='mod'||(newData.val()==='noble'||newData.val()==='knight'||newData.val()==='elite')||!newData.exists())) || ((root.child('anime/admins/'+auth.uid).val())==='mod' && data.val()!=='owner' && data.val()!=='mod' && ((newData.val()==='noble'||newData.val()==='knight'||newData.val()==='elite')||!newData.exists())))"
        }
      },
      "bans": {
        ".read": "auth!=null",
        "$n": {
          ".write": "auth!=null && (((root.child('anime/admins/'+auth.uid).val())==='owner' && root.child('anime/staff/'+$n).val()!=='owner') || ((root.child('anime/admins/'+auth.uid).val())==='mod' && root.child('anime/staff/'+$n).val()!=='mod' && root.child('anime/staff/'+$n).val()!=='owner'))"
        }
      },
      "mutes": {
        ".read": "auth!=null",
        "$n": {
          ".write": "auth!=null && (((root.child('anime/admins/'+auth.uid).val())==='owner' && root.child('anime/staff/'+$n).val()!=='owner') || ((root.child('anime/admins/'+auth.uid).val())==='mod' && root.child('anime/staff/'+$n).val()!=='mod' && root.child('anime/staff/'+$n).val()!=='owner'))"
        }
      },
      "users": {
        ".read": "auth!=null",
        "$n": {
          ".write": "auth!=null && root.child('anime/names/'+$n).val()===auth.uid && !root.child('anime/bans/'+$n).exists() && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')",
          ".validate": "newData.child('name').val()===$n && (!root.child('anime/config/minVersion').exists() || newData.child('v').val()>=root.child('anime/config/minVersion').val())"
        }
      },
      "saves": {
        "$n": {
          ".read": "auth!=null && (root.child('anime/names/'+$n).val()===auth.uid || root.child('anime/admins/'+auth.uid).exists())",
          ".write": "auth!=null && ((root.child('anime/names/'+$n).val()===auth.uid && !root.child('anime/bans/'+$n).exists()) || (((root.child('anime/admins/'+auth.uid).val())==='owner' && root.child('anime/staff/'+$n).val()!=='owner') || ((root.child('anime/admins/'+auth.uid).val())==='mod' && root.child('anime/staff/'+$n).val()!=='mod' && root.child('anime/staff/'+$n).val()!=='owner'))) && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')",
          ".validate": "newData.hasChildren(['coins','dia','owned']) && newData.child('coins').isNumber() && newData.child('coins').val()>=0 && newData.child('coins').val()<=10000000000000 && newData.child('dia').isNumber() && newData.child('dia').val()>=0 && newData.child('dia').val()<=100000000 && (!newData.child('pvp').exists() || (newData.child('pvp').isNumber() && newData.child('pvp').val()>=0 && newData.child('pvp').val()<=1000000)) && (!root.child('anime/config/minVersion').exists() || newData.child('v').val()>=root.child('anime/config/minVersion').val())"
        }
      },
      "mails": {
        "$n": {
          ".read": "auth!=null && root.child('anime/names/'+$n).val()===auth.uid",
          ".write": "auth!=null && root.child('anime/names/'+$n).val()===auth.uid",
          "friendRequests": {
            "$id": {
              ".write": "auth!=null && !data.exists() && newData.child('from').val()===root.child('anime/uids/'+auth.uid).val() && newData.child('from').val()!==$n && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
            }
          },
          "accepted": {
            "$id": {
              ".write": "auth!=null && !data.exists() && newData.child('from').val()===root.child('anime/uids/'+auth.uid).val() && newData.child('from').val()!==$n && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
            }
          },
          "notices": {
            "$id": {
              ".write": "auth!=null && !data.exists() && newData.child('from').val()===root.child('anime/uids/'+auth.uid).val() && newData.child('from').val()!==$n && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
            }
          }
        }
      },
      "invites": {
        "$n": {
          ".read": "auth!=null && root.child('anime/names/'+$n).val()===auth.uid",
          ".write": "auth!=null && root.child('anime/names/'+$n).val()===auth.uid",
          "$id": {
            ".write": "auth!=null && !data.exists() && newData.child('from').val()===root.child('anime/uids/'+auth.uid).val() && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
          }
        }
      },
      "globalChat": {
        ".read": "auth!=null",
        ".write": "auth!=null && root.child('anime/admins/'+auth.uid).exists()",
        "$id": {
          ".write": "auth!=null && !data.exists() && newData.child('name').val()===root.child('anime/uids/'+auth.uid).val() && !root.child('anime/bans/'+root.child('anime/uids/'+auth.uid).val()).exists() && !root.child('anime/mutes/'+root.child('anime/uids/'+auth.uid).val()).exists() && ((newData.child('admin').val()!==true && newData.child('notice').val()!==true) || root.child('anime/admins/'+auth.uid).exists()) && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')",
          ".validate": "newData.hasChildren(['name','msg','ts']) && newData.child('msg').isString() && newData.child('msg').val().length<=200"
        },
        ".indexOn": [
          "name"
        ]
      },
      "rooms": {
        ".read": "auth!=null",
        "$r": {
          ".write": "auth!=null && root.child('anime/uids/'+auth.uid).exists() && !root.child('anime/bans/'+root.child('anime/uids/'+auth.uid).val()).exists() && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
        }
      },
      "pvpRooms": {
        ".read": "auth!=null",
        "$r": {
          ".write": "auth!=null && root.child('anime/uids/'+auth.uid).exists() && !root.child('anime/bans/'+root.child('anime/uids/'+auth.uid).val()).exists() && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
        }
      },
      "tradeRooms": {
        ".read": "auth!=null",
        "$r": {
          ".write": "auth!=null && root.child('anime/uids/'+auth.uid).exists() && !root.child('anime/bans/'+root.child('anime/uids/'+auth.uid).val()).exists() && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
        }
      },
      "worldRooms": {
        ".read": "auth!=null",
        "$r": {
          "players": {
            "$id": {
              ".write": "auth!=null && $id===auth.uid && root.child('anime/uids/'+auth.uid).exists() && !root.child('anime/bans/'+root.child('anime/uids/'+auth.uid).val()).exists() && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
            }
          }
        }
      },
      "events": {
        ".read": "auth!=null",
        "$id": {
          ".write": "auth!=null && root.child('anime/admins/'+auth.uid).exists()",
          ".validate": "newData.hasChildren(['title','min','ts','endsAt']) && newData.child('title').isString() && newData.child('title').val().length<=60 && (newData.child('min').val()==='all'||newData.child('min').val()==='noble'||newData.child('min').val()==='knight'||newData.child('min').val()==='elite') && (!newData.child('coins').exists()||(newData.child('coins').isNumber() && newData.child('coins').val()>=0 && newData.child('coins').val()<=1000000000)) && (!newData.child('dia').exists()||(newData.child('dia').isNumber() && newData.child('dia').val()>=0 && newData.child('dia').val()<=100000))"
        }
      },
      "eventClaims": {
        ".read": "auth!=null",
        "$e": {
          "$n": {
            ".write": "auth!=null && root.child('anime/names/'+$n).val()===auth.uid && !data.exists() && newData.val()===true && root.child('anime/events/'+$e).exists() && root.child('anime/events/'+$e+'/endsAt').val()>now && ((root.child('anime/events/'+$e+'/min').val()==='all') || (((root.child('anime/events/'+$e+'/min').val())==='noble' && (root.child('anime/staff/'+$n).val()==='owner'||root.child('anime/staff/'+$n).val()==='mod'||root.child('anime/staff/'+$n).val()==='noble')) || ((root.child('anime/events/'+$e+'/min').val())==='knight' && (root.child('anime/staff/'+$n).val()==='owner'||root.child('anime/staff/'+$n).val()==='mod'||root.child('anime/staff/'+$n).val()==='noble'||root.child('anime/staff/'+$n).val()==='knight')) || ((root.child('anime/events/'+$e+'/min').val())==='elite' && root.child('anime/staff/'+$n).exists()))) && (!root.child('anime/config/maint/on').exists() || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='owner' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='mod' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='noble' || root.child('anime/staff/'+root.child('anime/uids/'+auth.uid).val()).val()==='knight')"
          }
        }
      },
      "config": {
        ".read": "auth!=null",
        ".write": "auth!=null && root.child('anime/admins/'+auth.uid).exists()"
      },
      "reports": {
        ".read": "auth!=null && root.child('anime/admins/'+auth.uid).exists()",
        ".write": "auth!=null && root.child('anime/admins/'+auth.uid).exists()",
        "$id": {
          ".write": "auth!=null && !data.exists() && newData.child('by').val()===root.child('anime/uids/'+auth.uid).val() && newData.child('target').val()!==newData.child('by').val() && root.child('anime/names/'+newData.child('target').val()).exists() && !root.child('anime/bans/'+root.child('anime/uids/'+auth.uid).val()).exists()",
          ".validate": "newData.hasChildren(['by','target','reason','ts']) && newData.child('reason').isString() && newData.child('reason').val().length<=30 && (!newData.child('msg').exists() || (newData.child('msg').isString() && newData.child('msg').val().length<=200))"
        }
      }
    }
  }
}